@page "/"

<PageTitle>Lumina Theme Studio</PageTitle>

<section class="hero-panel" id="preview">
    <div class="hero-panel__content">
        <p class="eyebrow">Application 07</p>
        <h1>A brighter workspace by day. A calmer one by night.</h1>
        <p class="hero-lead">
            Lumina keeps the interface balanced, readable, and personal across every refresh.
        </p>

        <div class="hero-actions" aria-label="Theme highlights">
            <span>Fast switch</span>
            <span>Saved preference</span>
            <span>Full page theme</span>
        </div>
    </div>

    <div class="product-shot" aria-label="Theme preview">
        <div class="product-shot__topbar">
            <span></span>
            <span></span>
            <span></span>
        </div>
        <div class="product-shot__grid">
            <div class="metric-tile">
                <small>Focus</small>
                <strong>92%</strong>
            </div>
            <div class="metric-tile metric-tile--warm">
                <small>Comfort</small>
                <strong>24h</strong>
            </div>
            <div class="insight-strip">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <div class="preview-card">
                <span class="preview-card__dot"></span>
                <div>
                    <strong>Theme memory</strong>
                    <p>Ready when the page opens again.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="experience-grid" id="experience" aria-label="Experience details">
    <article class="experience-card">
        <span class="experience-card__icon">01</span>
        <strong>Clean single page</strong>
        <p>A focused layout without the old left navigation panel.</p>
    </article>

    <article class="experience-card">
        <span class="experience-card__icon">02</span>
        <strong>Attractive theme states</strong>
        <p>Both light and dark palettes use polished contrast, shadows, and accents.</p>
    </article>

    <article class="experience-card">
        <span class="experience-card__icon">03</span>
        <strong>Persistent choice</strong>
        <p>The selected mode is restored automatically from browser local storage.</p>
    </article>
</section>
